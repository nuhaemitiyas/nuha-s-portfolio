<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nuha Emitiyas — Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;0,9..144,900;1,9..144,600&family=Archivo:ital,wght@0,500;0,600;0,700;0,800;1,600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper: #F1E9D6;
    --paper-2: #E7DAB8;
    --card: #FAF5E7;
    --ink: #201A12;
    --ink-soft: #55493A;
    --red: #B23A26;
    --red-dark: #8E2C1B;
    --blue: #2B4A85;
    --blue-dark: #1F3763;
    --cream: #FAF6EC;
    --display: 'Fraunces', serif;
    --body: 'Archivo', sans-serif;
  }

  *{ box-sizing: border-box; }

  body{
    margin:0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }

  a{ color: inherit; }
  ::selection{ background: var(--red); color: var(--cream); }

  a:focus-visible, button:focus-visible{
    outline: 3px solid var(--blue);
    outline-offset: 3px;
  }

  .wrap{
    max-width: 980px;
    margin: 0 auto;
    padding: 28px 22px 60px;
  }

  .block{
    border: 4px solid var(--ink);
  }

  /* ---------- stamp / sticker elements ---------- */

  .stamp{
    display: inline-block;
    font-family: var(--body);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.02em;
    background: var(--cream);
    border: 3px solid var(--ink);
    padding: 7px 13px;
    transform: rotate(-3deg);
  }

  /* ---------- Hero ---------- */

  .hero{
    background: var(--red);
    color: var(--cream);
    padding: 46px 34px 34px;
    margin-top: 10px;
    position: relative;
  }

  .postmark{
    position: absolute;
    top: -18px;
    left: 30px;
    background: var(--cream);
    color: var(--ink);
    transform: rotate(-5deg);
  }

  h1.name{
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(48px, 9vw, 92px);
    line-height: 0.94;
    margin: 30px 0 20px;
    color: var(--cream);
    text-shadow: 7px 7px 0 var(--blue-dark);
  }

  .role-tag{
    display: inline-block;
    background: var(--cream);
    color: var(--ink);
    border: 3px solid var(--ink);
    font-family: var(--display);
    font-style: italic;
    font-weight: 600;
    font-size: 19px;
    padding: 8px 16px;
    transform: rotate(-1.5deg);
    margin-bottom: 22px;
  }

  .pitch{
    max-width: 56ch;
    font-size: 17px;
    font-weight: 500;
    color: var(--cream);
    margin: 0 0 28px;
  }

  .contact-row{
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ticket{
    font-family: var(--body);
    font-weight: 700;
    font-size: 13px;
    text-decoration: none;
    background: var(--cream);
    color: var(--ink);
    border: 3px solid var(--ink);
    padding: 9px 14px;
  }
  .ticket:nth-child(2n){ transform: rotate(1.2deg); }
  .ticket:nth-child(2n+1){ transform: rotate(-1.2deg); }
  .ticket:hover{ background: var(--blue); color: var(--cream); }

  /* ---------- Section titles ---------- */

  section{ margin-top: 56px; }

  h2.section-title{
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(32px, 5vw, 46px);
    margin: 0 0 26px;
    display: inline-block;
    text-shadow: 4px 4px 0 var(--red);
  }

  /* ---------- Skills ---------- */

  .skill-row{
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  @media (max-width: 680px){ .skill-row{ grid-template-columns: 1fr; } }

  .skill-card{
    background: var(--card);
    border: 4px solid var(--ink);
    padding: 20px;
  }
  .skill-card:nth-child(1){ transform: rotate(-0.6deg); }
  .skill-card:nth-child(3){ transform: rotate(0.6deg); }

  .skill-card h3{
    font-family: var(--display);
    font-style: italic;
    font-weight: 600;
    font-size: 16px;
    margin: 0 0 14px;
    color: var(--ink-soft);
  }

  .pill-list{
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill{
    font-family: var(--body);
    font-weight: 700;
    font-size: 12.5px;
    padding: 5px 11px;
    border: 2px solid var(--ink);
    background: var(--paper);
  }
  .pill.b{ background: var(--blue); color: var(--cream); }
  .pill.r{ background: var(--red); color: var(--cream); }

  /* ---------- Projects ---------- */

  .project{
    border: 4px solid var(--ink);
    padding: 30px 28px;
    margin-bottom: 26px;
    position: relative;
  }
  .project.a{ background: var(--card); }
  .project.b{ background: var(--paper-2); }

  .project-head{
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 8px;
  }

  .project h3{
    font-family: var(--display);
    font-weight: 800;
    font-style: italic;
    font-size: 28px;
    margin: 0;
  }

  .stack-tags{
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .tag{
    font-family: var(--body);
    font-weight: 700;
    font-size: 11.5px;
    background: var(--ink);
    color: var(--cream);
    padding: 4px 9px;
  }

  .project ul{
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    color: var(--ink-soft);
    max-width: 66ch;
  }

  .project li{
    padding-left: 22px;
    position: relative;
    margin-bottom: 9px;
  }
  .project li::before{
    content: '▪';
    position: absolute;
    left: 0;
    color: var(--red);
    font-size: 15px;
  }

  .badge-metric{
    display: inline-block;
    font-family: var(--display);
    font-weight: 800;
    font-size: 15px;
    background: var(--blue);
    color: var(--cream);
    padding: 3px 9px;
    transform: rotate(-2deg);
    margin-left: 6px;
  }

  /* ---------- Certificates + Achievements (corkboard) ---------- */

  .cork{
    background: var(--paper-2);
    border: 4px solid var(--ink);
    padding: 30px 26px;
  }

  .cork-cols{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }
  @media (max-width: 680px){ .cork-cols{ grid-template-columns: 1fr; } }

  .cork h4{
    font-family: var(--display);
    font-style: italic;
    font-weight: 600;
    font-size: 15px;
    margin: 0 0 16px;
    color: var(--ink-soft);
  }

  .clip{
    background: var(--card);
    border: 3px solid var(--ink);
    padding: 12px 14px;
    margin-bottom: 12px;
    font-size: 13.5px;
    font-weight: 600;
  }
  .clip:nth-child(odd){ transform: rotate(-1.3deg); }
  .clip:nth-child(even){ transform: rotate(1.1deg); }

  .clip .when{
    display: block;
    font-family: var(--body);
    font-weight: 700;
    font-size: 11px;
    color: var(--red-dark);
    margin-top: 4px;
  }

  .vogue-badge{
    margin-top: 18px;
    background: var(--red);
    color: var(--cream);
    border: 4px solid var(--ink);
    padding: 18px 20px;
    text-align: center;
    transform: rotate(-1deg);
  }
  .vogue-badge .title{
    font-family: var(--display);
    font-weight: 900;
    font-size: 24px;
    text-shadow: 3px 3px 0 var(--blue-dark);
    display: block;
    margin-bottom: 6px;
  }
  .vogue-badge .sub{
    font-family: var(--body);
    font-size: 12.5px;
    font-weight: 600;
  }

  /* ---------- Education ---------- */

  .edu-ledger{
    border: 4px solid var(--ink);
    background: var(--card);
  }

  .edu-row{
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px;
    padding: 22px 24px;
    border-bottom: 3px solid var(--ink);
    align-items: center;
  }
  .edu-row:last-child{ border-bottom: none; }

  .edu-row h4{
    font-family: var(--display);
    font-weight: 700;
    font-size: 18px;
    margin: 0 0 4px;
  }

  .edu-row .place{
    font-size: 13.5px;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .edu-stat{
    text-align: right;
  }

  .edu-stat .num{
    display: inline-block;
    font-family: var(--display);
    font-weight: 800;
    font-size: 22px;
    background: var(--blue);
    color: var(--cream);
    padding: 3px 12px;
  }

  .edu-stat .period{
    display: block;
    font-family: var(--body);
    font-weight: 700;
    font-size: 11px;
    color: var(--ink-soft);
    margin-top: 6px;
  }

  /* ---------- Footer ---------- */

  footer{
    margin-top: 60px;
    background: var(--blue);
    color: var(--cream);
    border: 4px solid var(--ink);
    padding: 26px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  footer .fname{
    font-family: var(--display);
    font-weight: 800;
    font-style: italic;
    font-size: 18px;
  }

  footer a{
    font-family: var(--body);
    font-weight: 700;
    font-size: 13.5px;
    text-decoration: underline;
  }

  @media (max-width: 620px){
    .stamp, .role-tag, .ticket, .skill-card, .clip, .vogue-badge{
      transform: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce){
    *{ scroll-behavior: auto !important; }
  }
</style>
</head>
